# Apify API Token (obtain from https://console.apify.com/settings/integrations)
APIFY_TOKEN=your_apify_api_token_here
APIFY_API_TOKEN=your_apify_api_token_here

# Gemini API Key (V1 legacy fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# LeadPulse AI V2 Model Provider (OpenAI Agents SDK / OpenAI-compatible API)
AI_API_KEY=your_openai_compatible_api_key_here
AI_BASE_URL=https://your-custom-llm-endpoint.com/v1
AI_MODEL=your_model_identifier_here
AI_API_MODE=chat_completions

# Python AI Worker Internal Gateway
AI_WORKER_URL=http://localhost:8000
